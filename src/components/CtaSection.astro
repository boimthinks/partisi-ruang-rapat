---
import { Phone, ArrowRight, ShieldCheck, MapPin, Sparkles } from '@lucide/astro';
---

<section class="py-16 lg:py-24 relative overflow-hidden bg-blueprint reveal-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="glass-panel rounded-3xl p-8 sm:p-14 border border-[#00e5ff]/30 shadow-2xl relative overflow-hidden">
      
      <!-- Background glow effect -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#00e5ff]/20 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00e5ff]/10 text-[#00e5ff] text-xs font-mono">
            <Sparkles class="w-3.5 h-3.5" />
            <span>KONSULTASI GRATIS & SURVEI LOKASI NASIONAL</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
            Rencanakan Partisi Ruang Rapat Kantor Anda Bersama CV Pireki Asia
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
            Dapatkan penawaran harga pabrik resmi, simulasi RAB akurat, serta konsultasi struktur balok gantung plafon langsung dari tim teknisi ahli kami.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-300 font-mono">
            <span class="flex items-center gap-1.5 text-emerald-400">
              <ShieldCheck class="w-4 h-4" />
              Garansi Komponen 2 Tahun
            </span>
            <span class="flex items-center gap-1.5 text-cyan-300">
              <MapPin class="w-4 h-4" />
              Survei Jabodetabek, Jatim, Jateng & Luar Pulau
            </span>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-3">
          <a
            href="https://wa.me/6282376737701?text=Halo%20Pireki%2C%20saya%20ingin%20jadwalkan%20survei%20dan%20penawaran%20partisi%20ruang%20rapat"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl font-extrabold text-sm text-[#070e1e] bg-gradient-to-r from-[#00e5ff] to-cyan-200 hover:to-white shadow-xl shadow-[#00e5ff]/25 transition-all duration-300 transform active:scale-95"
          >
            <Phone class="w-4 h-4" />
            <span>Chat WhatsApp 0823-7673-7701</span>
          </a>

          <a
            href="/harga/"
            class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-xs text-white bg-white/5 hover:bg-white/10 border border-white/15 transition-all duration-200"
          >
            <span>Buka Simulasi Estimasi RAB</span>
            <ArrowRight class="w-4 h-4 text-[#00e5ff]" />
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
