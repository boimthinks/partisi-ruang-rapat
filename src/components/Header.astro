---
import { Phone, Menu, X, ArrowUpRight, ChevronDown } from '@lucide/astro';

const sectorItems = [
  { label: 'Kantor & Boardroom', href: '/kantor/' },
  { label: 'Hotel & Ballroom', href: '/hotel/' },
  { label: 'Instansi & BUMN', href: '/instansi/' },
  { label: 'Kampus & Aula', href: '/kampus/' },
];

const navItems = [
  { label: 'Tipe Partisi', href: '/tipe/' },
  { label: 'Teknis', href: '/teknis/' },
  { label: 'Estimasi Harga', href: '/harga/' },
  { label: 'Proyek', href: '/proyek/' },
  { label: 'Lokasi', href: '/lokasi/' },
  { label: 'Blog', href: '/blog/' },
];

const currentPath = Astro.url.pathname;
const isSectorActive = sectorItems.some(item => currentPath.startsWith(item.href));
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#070e1e]/85 backdrop-blur-md transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Brand Badge -->
      <a href="/" class="flex items-center group py-2" aria-label="Pireki - Partisi Ruang Rapat">
        <img 
          src="/logo-pireki/logo-pireki.svg" 
          alt="Pireki" 
          class="h-7 sm:h-8 w-auto transition-opacity duration-200 group-hover:opacity-90" 
          width="152" 
          height="32" 
          loading="eager"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        <a
          href="/tipe/"
          class={`px-3.5 py-2 rounded-full text-xs lg:text-sm font-medium transition-all duration-200 ${
            currentPath.startsWith('/tipe/')
              ? 'text-[#00e5ff] bg-white/5 border border-[#00e5ff]/30 shadow-sm'
              : 'text-slate-300 hover:text-white hover:bg-white/5'
          }`}
        >
          Tipe Partisi
        </a>

        <!-- Dropdown Penerapan Partisi -->
        <div class="relative group">
          <button
            type="button"
            class={`flex items-center gap-1 px-3.5 py-2 rounded-full text-xs lg:text-sm font-medium transition-all duration-200 ${
              isSectorActive
                ? 'text-[#00e5ff] bg-white/5 border border-[#00e5ff]/30 shadow-sm'
                : 'text-slate-300 hover:text-white hover:bg-white/5'
            }`}
          >
            <span>Penerapan Partisi</span>
            <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
          </button>
          
          <div class="absolute left-0 top-full pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="glass-panel rounded-xl bg-[#0a1428] border border-white/10 shadow-2xl p-2">
              {sectorItems.map((sec) => (
                <a
                  href={sec.href}
                  class={`block px-3 py-2 rounded-lg text-xs font-medium transition-colors ${
                    currentPath.startsWith(sec.href)
                      ? 'text-[#00e5ff] bg-white/5 font-semibold'
                      : 'text-slate-300 hover:text-white hover:bg-white/5'
                  }`}
                >
                  {sec.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        {navItems.slice(1).map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-full text-xs lg:text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'text-[#00e5ff] bg-white/5 border border-[#00e5ff]/30 shadow-sm'
                  : 'text-slate-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="https://wa.me/6282376737701?text=Halo%20Pireki%2C%20saya%20ingin%20konsultasi%20partisi%20ruang%20rapat"
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-xs font-semibold text-[#070e1e] bg-gradient-to-r from-[#00e5ff] to-cyan-300 hover:to-white shadow-lg shadow-[#00e5ff]/25 hover:shadow-[#00e5ff]/40 transition-all duration-300 transform active:scale-95"
        >
          <Phone class="w-3.5 h-3.5" />
          <span>Konsultasi WA</span>
          <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Toggle menu"
      >
        <Menu id="icon-menu" class="w-6 h-6" />
        <X id="icon-close" class="w-6 h-6 hidden" />
      </button>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-drawer"
    class="hidden md:hidden border-b border-white/10 bg-[#0a1428] px-4 pt-3 pb-6 transition-all duration-300"
  >
    <div class="flex flex-col gap-1">
      <a
        href="/tipe/"
        class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:text-[#00e5ff] hover:bg-white/5 transition-colors"
      >
        Tipe Partisi
      </a>
      
      <!-- Penerapan Partisi Mobile Section -->
      <div class="px-4 pt-2 pb-1 text-[11px] font-mono uppercase text-[#00e5ff] tracking-wider font-semibold">
        Penerapan Partisi:
      </div>
      <div class="grid grid-cols-2 gap-1 px-2 mb-2">
        {sectorItems.map((sec) => (
          <a
            href={sec.href}
            class="px-3 py-2 rounded text-xs text-slate-300 hover:text-white bg-white/5 hover:bg-white/10"
          >
            {sec.label}
          </a>
        ))}
      </div>

      {navItems.slice(1).map((item) => (
        <a
          href={item.href}
          class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-200 hover:text-[#00e5ff] hover:bg-white/5 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400 px-2">
          <span>Sertifikasi Resmi</span>
          <span class="text-emerald-400 font-semibold">TKDN & Garansi 2 Tahun</span>
        </div>
        <a
          href="https://wa.me/6282376737701?text=Halo%20Pireki%2C%20saya%20ingin%20konsultasi%20partisi%20ruang%20rapat"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold text-[#070e1e] bg-[#00e5ff] hover:bg-white transition-all shadow-md"
        >
          <Phone class="w-4 h-4" />
          <span>Hubungi Tim Ahli (WhatsApp)</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!btn || !drawer || !iconMenu || !iconClose) return;

    btn.onclick = () => {
      const isExpanded = !drawer.classList.contains('hidden');
      if (isExpanded) {
        drawer.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        drawer.classList.remove('hidden');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
      }
    };
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
