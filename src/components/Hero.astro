---
import { VolumeX, Layers, CheckCircle, ShieldCheck, ArrowRight, Ruler, Wrench } from '@lucide/astro';
---

<section class="relative pt-12 pb-20 lg:pt-20 lg:pb-32 overflow-hidden bg-blueprint">
  <!-- Glow orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[#00e5ff]/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -top-24 right-0 w-[300px] h-[300px] bg-[#2563eb]/15 rounded-full blur-[90px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text & Value Proposition (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Technical Label -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-[#00e5ff]/30 text-xs font-mono text-[#00e5ff]">
          <span class="w-2 h-2 rounded-full bg-[#00e5ff] animate-pulse"></span>
          <span>SPESIALISASI PEREDAM SUARA RUANG RAPAT & BOARDROOM</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Solusi Partisi Ruang Rapat <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00e5ff] via-cyan-200 to-blue-400">
            Kedap Suara Hingga 60 dB
          </span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
          Ciptakan ruang rapat multifungsi berstandar privat korporasi. Menggunakan sistem partisi geser rel gantung 
          <strong class="text-white">tanpa rel lantai</strong>, peredam Rockwool 80 kg/m³, dan mekanisme jack mekanik 
          yang mengunci kerapatan akustik secara maksimal.
        </p>

        <!-- 3 Technical Pillars -->
        <div class="grid grid-cols-3 gap-3 pt-2">
          <div class="p-3 rounded-lg bg-white/5 border border-white/10">
            <div class="text-[#00e5ff] font-mono text-xl font-bold">60 dB</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono">Peredaman Akustik</div>
          </div>
          <div class="p-3 rounded-lg bg-white/5 border border-white/10">
            <div class="text-[#00e5ff] font-mono text-xl font-bold">80 kg/m³</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono">High Rockwool</div>
          </div>
          <div class="p-3 rounded-lg bg-white/5 border border-white/10">
            <div class="text-emerald-400 font-mono text-xl font-bold">0 mm</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider font-mono">Tanpa Rel Lantai</div>
          </div>
        </div>

        <!-- Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4">
          <a
            href="https://wa.me/6282376737701?text=Halo%20Pireki%2C%20saya%20ingin%20konsultasi%20kebutuhan%20partisi%20ruang%20rapat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg text-sm font-bold text-[#070e1e] bg-[#00e5ff] hover:bg-white shadow-xl shadow-[#00e5ff]/20 hover:shadow-[#00e5ff]/40 transition-all duration-300 transform active:scale-95"
          >
            <span>Konsultasi & Survei Ruangan</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href="/harga/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg text-sm font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/15 transition-all duration-200"
          >
            <Ruler class="w-4 h-4 text-[#00e5ff]" />
            <span>Hitung Estimasi Biaya</span>
          </a>
        </div>

        <!-- Trust Signals -->
        <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-400">
          <div class="flex items-center gap-1.5">
            <CheckCircle class="w-4 h-4 text-[#00e5ff]" />
            <span>Pabrik Langsung (Bukan Reseller)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <ShieldCheck class="w-4 h-4 text-[#00e5ff]" />
            <span>Garansi Resmi CV Pireki Asia</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Wrench class="w-4 h-4 text-[#00e5ff]" />
            <span>Teknisi In-House Nasional</span>
          </div>
        </div>

      </div>

      <!-- Technical Showcase Card (5 Cols) -->
      <div class="lg:col-span-5">
        <div class="glass-panel rounded-2xl p-6 sm:p-8 relative shadow-2xl border border-white/10">
          
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              <span class="font-mono text-xs text-slate-300 uppercase tracking-widest">Spesifikasi Sorepa Pro</span>
            </div>
            <span class="font-mono text-xs text-[#00e5ff] px-2 py-0.5 rounded bg-[#00e5ff]/10">TOP RATED</span>
          </div>

          <!-- Feature Breakdown Items -->
          <div class="space-y-4">
            
            <div class="flex items-start gap-3 p-3 rounded-lg bg-black/20 border border-white/5">
              <div class="w-8 h-8 rounded bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center shrink-0 mt-0.5 font-mono text-xs font-bold">
                01
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white">Mekanisme Jack Device Atas & Bawah</h4>
                <p class="text-xs text-slate-400 mt-0.5">
                  Menekan karet peredam ke lantai dan rel atas secara mekanis, menutup kebocoran desibel 100%.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-lg bg-black/20 border border-white/5">
              <div class="w-8 h-8 rounded bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center shrink-0 mt-0.5 font-mono text-xs font-bold">
                02
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white">Insulasi Rockwool 80 kg/m³</h4>
                <p class="text-xs text-slate-400 mt-0.5">
                  Densitas peredam tertinggi Pireki, menyerap frekuensi suara rapat direksi, presentasi, dan audio video.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-lg bg-black/20 border border-white/5">
              <div class="w-8 h-8 rounded bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center shrink-0 mt-0.5 font-mono text-xs font-bold">
                03
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white">Clean Floor Suspension</h4>
                <p class="text-xs text-slate-400 mt-0.5">
                  Bebas rel bawah tanah. Karpet ruang rapat tetap rata, estetis, dan aman dari bahaya tersandung.
                </p>
              </div>
            </div>

          </div>

          <!-- Quick Stat Badge -->
          <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Tingkat Kekedapan Suara:</span>
            <span class="text-emerald-400 font-bold">★★★★★ (Privat & Rahasia)</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
