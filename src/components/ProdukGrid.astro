---
import { Volume2, ShieldCheck, CheckCircle } from '@lucide/astro';

interface Props {
  columns?: 2 | 4;
  title?: string;
  eyebrow?: string;
  description?: string;
  id?: string;
  borderTop?: boolean;
}

const {
  columns = 2,
  title = 'Pilihan Partisi Ruang Rapat',
  eyebrow = 'KATALOG PRODUK RESMI PIREKI',
  description = 'Setiap produk diproduksi in-house dengan kontrol kualitas presisi untuk menjamin kenyamanan privasi diskusi internal perusahaan.',
  id = 'produk',
  borderTop = false,
} = Astro.props;

const gridClass = columns === 2
  ? 'grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8'
  : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6';

const products = [
  {
    badge: 'FLAGSHIP KEDAP SUARA',
    name: 'SOREPA PRO',
    slug: '/tipe/sorepa-pro/',
    image: '/img/tipe-sorepa-pro_poco.webp',
    acousticRating: 'Hingga 60 dB',
    insulation: 'Rockwool 80 kg/m³',
    locking: 'Mechanical Jack Device Atas-Bawah',
    frame: 'Hollow Besi 5x5 cm & MDF 12 mm',
    suspension: 'Rel Gantung Heavy Duty (Tanpa Rel Lantai)',
    bestFor: 'Boardroom Direksi, Ruang Sidang, VIP Meeting Room, Ballroom Hotel',
    accentColor: 'from-[#00e5ff] to-blue-500',
    popular: true,
  },
  {
    badge: 'SLIDING PERSECTION',
    name: 'SOREPA PRIMA',
    slug: '/tipe/sorepa-prima/',
    image: '/img/tipe-sorepa-prima_poco.webp',
    acousticRating: 'Hingga 60 dB',
    insulation: 'Rockwool 60 kg/m³',
    locking: 'Sistem Jack Mekanik',
    frame: 'Hollow 5x5 cm & Panel 12 mm',
    suspension: 'Box Penyimpanan Samping (Stacking)',
    bestFor: 'Ruang Rapat Modular, Kampus, Gedung Serbaguna',
    accentColor: 'from-blue-400 to-indigo-600',
    popular: false,
  },
  {
    badge: 'SLIDING MID-RANGE',
    name: 'SAMOWA PERSECTION',
    slug: '/tipe/samowa-persection/',
    image: '/img/tipe-samowa-persection_poco.webp',
    acousticRating: 'Semi Kedap Suara',
    insulation: 'Rockwool 30 kg/m³',
    locking: 'Jack Mekanik (Panel Terakhir) & Grendel',
    frame: 'Hollow 5x5 cm & Panel 9 mm',
    suspension: 'Rel Gantung Heavy Duty 8 cm',
    bestFor: 'Ruang Rapat Kantor, Aula Kampus, Sekolah',
    accentColor: 'from-teal-400 to-cyan-600',
    popular: false,
  },
  {
    badge: 'SISTEM PINTU LIPAT',
    name: 'SAMOWA LIPAT',
    slug: '/tipe/samowa-lipat/',
    image: '/img/tipe-samowa-lipat_poco.webp',
    acousticRating: 'Semi Kedap Suara',
    insulation: 'Glasswool 30 kg/m³',
    locking: 'Grendel Tanam & Engsel Kupu-kupu',
    frame: 'Hollow 4x4 cm + Kayu Meranti',
    suspension: 'Rel Gantung Lipat Berantai',
    bestFor: 'Ruang Rapat Kantor Standar, Balai Diklat, Ruang Kelas Pelatihan',
    accentColor: 'from-cyan-400 to-teal-500',
    popular: false,
  }
];
---

<section id={id} class={`py-16 lg:py-24 relative reveal-on-scroll ${borderTop ? 'border-t border-white/10' : ''}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="text-[#00e5ff] font-mono text-xs uppercase tracking-widest mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00e5ff]"></span>
          <span>{eyebrow}</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white">
          {title}
        </h2>
      </div>
      <p class="text-slate-400 text-xs sm:text-sm max-w-md mt-3 md:mt-0">
        {description}
      </p>
    </div>

    <!-- Product Cards Grid -->
    <div class={gridClass}>
      {products.map((item) => (
        <div class={`rounded-2xl flex flex-col justify-between p-5 sm:p-6 relative transition-all duration-300 hover:-translate-y-1 group ${
          item.popular
            ? 'glass-panel border-[#00e5ff]/40 shadow-xl shadow-[#00e5ff]/10 ring-1 ring-[#00e5ff]/30'
            : 'glass-panel border-white/10 hover:border-white/20'
        }`}>
          
          <div>
            <!-- Gambar Produk (Klik menuju detail halaman produk) -->
            <a
              href={item.slug}
              class="block relative w-full aspect-[4/3] rounded-xl overflow-hidden mb-5 border border-white/10 hover:border-[#00e5ff]/50 bg-black/40 group/img transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#00e5ff] cursor-pointer"
              title={`Buka spesifikasi ${item.name}`}
            >
              <img
                src={item.image}
                alt={`Partisi Ruang Rapat ${item.name} CV Pireki Asia`}
                class="w-full h-full object-cover group-hover:scale-105 group-hover/img:scale-105 transition-transform duration-500"
                loading="lazy"
                width="600"
                height="450"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#070e1e]/80 via-transparent to-transparent"></div>
              
              <div class="absolute top-3 left-3">
                <span class="text-[10px] font-mono tracking-wider font-bold text-[#00e5ff] uppercase px-2.5 py-1 rounded bg-[#070e1e]/90 backdrop-blur-md border border-[#00e5ff]/30 shadow-md">
                  {item.badge}
                </span>
              </div>
              
              {item.popular && (
                <div class="absolute top-3 right-3">
                  <span class="flex items-center gap-1 text-[10px] font-mono text-emerald-300 font-semibold px-2 py-1 rounded bg-[#070e1e]/90 backdrop-blur-md border border-emerald-500/30 shadow-md">
                    <ShieldCheck class="w-3 h-3 text-emerald-400" />
                    <span>Rekomendasi Utama</span>
                  </span>
                </div>
              )}
            </a>

            <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight group-hover:text-[#00e5ff] transition-colors">
              {item.name}
            </h3>

            <!-- Acoustic highlight banner -->
            <div class="mt-4 p-3 rounded-lg bg-black/30 border border-white/5 flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs text-slate-300">
                <Volume2 class="w-4 h-4 text-[#00e5ff]" />
                <span>Peredaman:</span>
              </div>
              <span class="font-mono text-xs font-bold text-[#00e5ff]">{item.acousticRating}</span>
            </div>

            <!-- Specs details -->
            <div class="mt-5 space-y-2.5 text-xs text-slate-300">
              <div class="flex items-start gap-2">
                <CheckCircle class="w-4 h-4 text-[#00e5ff] shrink-0 mt-0.5" />
                <span><strong>Insulasi:</strong> {item.insulation}</span>
              </div>
              <div class="flex items-start gap-2">
                <CheckCircle class="w-4 h-4 text-[#00e5ff] shrink-0 mt-0.5" />
                <span><strong>Penguncian:</strong> {item.locking}</span>
              </div>
              <div class="flex items-start gap-2">
                <CheckCircle class="w-4 h-4 text-[#00e5ff] shrink-0 mt-0.5" />
                <span><strong>Struktur:</strong> {item.frame}</span>
              </div>
              <div class="flex items-start gap-2">
                <CheckCircle class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong>Suspensi:</strong> {item.suspension}</span>
              </div>
            </div>

            <!-- Best for tag -->
            <div class="mt-6 pt-4 border-t border-white/10 text-[11px] text-slate-400">
              <strong class="text-white block mb-1">Aplikasi Terbaik:</strong>
              {item.bestFor}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
