---
import type { CollectionEntry } from 'astro:content';
import { MapPin, CheckCircle2 } from '@lucide/astro';

interface Props {
  proyek: CollectionEntry<'artikel'>;
}

const { proyek } = Astro.props;
const { title, description, tipe, lokasi, aplikasi, image } = proyek.data;
const href = `/proyek/${proyek.id}/`;
---

<div class="glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 hover:border-[#00e5ff]/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1">
  <div>
    <!-- Gambar Proyek 4:3 (Klik langsung menuju detail dokumentasi proyek) -->
    {image && (
      <a
        href={href}
        class="block relative w-full aspect-[4/3] rounded-xl overflow-hidden mb-5 border border-white/10 hover:border-[#00e5ff]/50 bg-black/40 group/img transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#00e5ff] cursor-pointer"
        title={`Buka dokumentasi ${title}`}
      >
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 group-hover/img:scale-105 transition-transform duration-500"
          loading="lazy"
          width="600"
          height="450"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#070e1e]/90 via-[#070e1e]/20 to-transparent"></div>
        
        {tipe && (
          <div class="absolute top-3 left-3">
            <span class="text-[10px] font-mono tracking-wider font-bold text-[#00e5ff] uppercase px-2.5 py-1 rounded bg-[#070e1e]/90 backdrop-blur-md border border-[#00e5ff]/30 shadow-md">
              {tipe}
            </span>
          </div>
        )}

        {lokasi && (
          <div class="absolute bottom-2.5 left-3 right-3">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-300 px-2 py-0.5 rounded bg-[#070e1e]/80 border border-white/10 backdrop-blur-md inline-flex items-center gap-1">
              <MapPin class="w-3 h-3 text-[#00e5ff] shrink-0" />
              <span class="truncate max-w-[200px]">{lokasi}</span>
            </span>
          </div>
        )}
      </a>
    )}

    {aplikasi && (
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">
          {aplikasi}
        </span>
      </div>
    )}

    <h3 class="text-lg font-bold text-white group-hover:text-[#00e5ff] transition-colors line-clamp-2">
      {title}
    </h3>

    <p class="text-xs text-slate-300 mt-2.5 leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-emerald-400">
    <span class="flex items-center gap-1.5">
      <CheckCircle2 class="w-3.5 h-3.5" />
      <span>Selesai Terpasang & Bergaransi</span>
    </span>
  </div>
</div>
