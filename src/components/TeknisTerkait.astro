---
import { getCollection } from 'astro:content';
import { Cpu, ArrowUpRight, ArrowRight, Calendar } from '@lucide/astro';

interface Props {
  currentSlug: string;
  aplikasi?: 'kantor' | 'hotel' | 'instansi' | 'kampus';
  tipe?: string;
  title?: string;
  eyebrow?: string;
  description?: string;
  limit?: number;
}

const {
  currentSlug,
  aplikasi,
  tipe,
  title = 'Kajian & Panduan Teknis Terkait',
  eyebrow = 'DOKUMENTASI REKAYASA AKUSTIK',
  description = 'Pelajari analisis beban struktur balok, sains peredam desibel, dan detail mekanikal partisi lainnya.',
  limit = 3,
} = Astro.props;

// Ambil semua artikel bertipe teknis selain artikel yang sedang dibuka
const allTeknis = await getCollection('artikel', ({ data, id }) => data.label === 'teknis' && id !== currentSlug);

// Urutkan artikel terkait dengan prioritas kesesuaian tipe / sektor aplikasi
const sortedTeknis = allTeknis.sort((a, b) => {
  let scoreA = 0;
  let scoreB = 0;

  if (tipe && a.data.tipe === tipe) scoreA += 2;
  if (tipe && b.data.tipe === tipe) scoreB += 2;

  if (aplikasi && a.data.aplikasi === aplikasi) scoreA += 1;
  if (aplikasi && b.data.aplikasi === aplikasi) scoreB += 1;

  if (scoreA !== scoreB) {
    return scoreB - scoreA;
  }

  // Jika bobot kategori sama, prioritaskan tanggal terbaru
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const displayTeknis = sortedTeknis.slice(0, limit);
---

{displayTeknis.length > 0 && (
  <section class="py-14 sm:py-20 bg-[#070e1e] border-t border-white/10 reveal-on-scroll">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 text-xs font-mono text-[#00e5ff] uppercase tracking-wider mb-2">
            <Cpu class="w-3.5 h-3.5" />
            <span>{eyebrow}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            {title}
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm mt-2 leading-relaxed">
            {description}
          </p>
        </div>

        <a
          href="/teknis/"
          class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[#00e5ff] hover:text-white group shrink-0 transition-colors"
        >
          <span>Semua Dokumentasi Teknis</span>
          <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
        </a>
      </div>

      <!-- Grid Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {displayTeknis.map((item) => {
          const href = `/teknis/${item.id}/`;
          const formattedDate = new Intl.DateTimeFormat('id-ID', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          }).format(item.data.date);

          return (
            <div class="glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 hover:border-[#00e5ff]/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-xl">
              <div>
                {item.data.image && (
                  <a
                    href={href}
                    class="block relative w-full aspect-[4/3] rounded-xl overflow-hidden mb-5 border border-white/10 hover:border-[#00e5ff]/50 bg-black/40 group/img transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#00e5ff] cursor-pointer"
                    title={`Baca kajian teknis: ${item.data.title}`}
                  >
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 group-hover/img:scale-105 transition-transform duration-500"
                      loading="lazy"
                      width="600"
                      height="450"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#070e1e]/90 via-[#070e1e]/20 to-transparent"></div>
                    
                    {item.data.tipe && (
                      <div class="absolute top-3 left-3">
                        <span class="text-[10px] font-mono tracking-wider font-bold text-[#00e5ff] uppercase px-2.5 py-1 rounded bg-[#070e1e]/90 backdrop-blur-md border border-[#00e5ff]/30 shadow-md">
                          {item.data.tipe}
                        </span>
                      </div>
                    )}

                    <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-[11px] font-mono text-slate-300">
                      <span class="px-2 py-0.5 rounded bg-[#070e1e]/80 border border-white/10 backdrop-blur-md inline-flex items-center gap-1.5 text-slate-300">
                        <Calendar class="w-3 h-3 text-[#00e5ff] shrink-0" />
                        <span>{formattedDate}</span>
                      </span>
                    </div>
                  </a>
                )}

                <div class="flex items-center gap-2 mb-3">
                  {item.data.aplikasi && (
                    <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded border border-emerald-500/20">
                      Sektor {item.data.aplikasi}
                    </span>
                  )}
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[#00e5ff] bg-[#00e5ff]/10 px-2 py-0.5 rounded">
                    Teknis
                  </span>
                </div>

                <a href={href} class="block group/link">
                  <h3 class="text-base sm:text-lg font-bold text-white group-hover/link:text-[#00e5ff] transition-colors line-clamp-2 leading-snug">
                    {item.data.title}
                  </h3>
                </a>

                <p class="text-xs text-slate-300 leading-relaxed mt-2.5 line-clamp-3">
                  {item.data.description}
                </p>
              </div>

              <div class="pt-4 mt-5 border-t border-white/10 flex items-center justify-between">
                <span class="text-[11px] font-mono text-slate-400">
                  {item.data.author}
                </span>
                <a
                  href={href}
                  class="inline-flex items-center gap-1 text-xs font-mono font-semibold text-[#00e5ff] group-hover:translate-x-1 transition-transform"
                >
                  <span>Baca Kajian</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
)}
