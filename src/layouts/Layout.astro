---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  schemaExtra?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Partisi Ruang Rapat Kedap Suara | Produsen Movable Wall Pireki",
  description = "Produsen partisi ruang rapat kedap suara hingga 60 dB. Spesialis sekat geser movable wall & folding door kantor, hotel, dan ballroom resmi CV Pireki Asia.",
  ogImage = "/images/og-partisi-ruang-rapat.jpg",
  ogType = "website",
  schemaExtra
} = Astro.props;

// Pastikan canonical selalu memiliki trailing slash
const canonicalURL = new URL(Astro.url.pathname.replace(/\/+$/, '') + '/', Astro.site);

// Resolve absolute URL untuk ogImage agar optimal di semua platform sosmed
const fullOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site || 'https://partisiruangrapat.web.id').toString();

const baseGraph = [
  {
    "@type": "Organization",
    "@id": "https://partisiruangrapat.web.id/#organization",
    "name": "CV Pireki Asia - Spesialis Partisi Ruang Rapat",
    "url": "https://partisiruangrapat.web.id/",
    "logo": "https://partisiruangrapat.web.id/logo-pireki/logo-pireki.svg",
    "sameAs": [
      "https://pireki.id",
      "https://www.youtube.com/@pireki",
      "https://www.instagram.com/partisipireki/"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+62-823-7673-7701",
      "contactType": "sales",
      "areaServed": "ID",
      "availableLanguage": ["Indonesian", "English"]
    }
  },
  {
    "@type": "LocalBusiness",
    "@id": "https://partisiruangrapat.web.id/#localbusiness",
    "name": "Partisi Ruang Rapat - CV Pireki Asia",
    "image": fullOgImage,
    "telephone": "+6282376737701",
    "priceRange": "Rp 1.378.000 - Rp 3.500.000 per m2",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Jl. Bangkingan Gadung No. 168 RT 001 RW 002, Lakarsantri",
      "addressLocality": "Surabaya",
      "addressRegion": "Jawa Timur",
      "postalCode": "60214",
      "addressCountry": "ID"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -7.316824,
      "longitude": 112.654109
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  }
];

const extraItems = Array.isArray(schemaExtra)
  ? schemaExtra
  : schemaExtra
    ? [schemaExtra]
    : [];

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseGraph,
    ...extraItems
  ]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Pireki - Partisi Ruang Rapat Kedap Suara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="600" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- View Transitions -->
    <ClientRouter />

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-[#070e1e] text-slate-100 antialiased selection:bg-[#00e5ff] selection:text-[#070e1e] min-h-screen flex flex-col justify-between">
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Client-side script for scroll animations and interactions with View Transitions -->
    <script>
      function setupScrollObserver() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      }

      // Jalankan pada load pertama dan setiap kali navigasi View Transitions selesai
      document.addEventListener('astro:page-load', () => {
        setupScrollObserver();
      });
    </script>
  </body>
</html>
