---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import ProyekTerkait from '../components/ProyekTerkait.astro';
import { Hotel, CheckCircle2, ArrowLeft, Phone } from '@lucide/astro';

const schemaService = {
  "@type": "Service",
  "@id": "https://partisiruangrapat.web.id/hotel/#service",
  "name": "Pemasangan Partisi Meeting Room Hotel & Ballroom",
  "serviceType": "Instalasi Partisi Geser Akustik Ballroom & Meeting Room Hotel",
  "description": "Layanan partisi geser peredam suara movable wall untuk meeting room hotel dan ballroom serbaguna dengan sistem rel gantung tanpa merusak karpet mewah.",
  "provider": {
    "@id": "https://partisiruangrapat.web.id/#organization"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "image": "https://partisiruangrapat.web.id/img/partisi-ruang-rapat-hotel_poco.webp"
};

const schemaBreadcrumb = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://partisiruangrapat.web.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Penerapan Partisi",
      "item": "https://partisiruangrapat.web.id/#sektor"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Meeting Room Hotel & Ballroom",
      "item": "https://partisiruangrapat.web.id/hotel/"
    }
  ]
};
---

<Layout
  title="Partisi Meeting Room Hotel & Ballroom Kedap Suara | Pireki"
  description="Partisi geser kedap suara untuk meeting room hotel dan ballroom serbaguna. Fleksibilitas zonasi ruangan untuk meningkatkan okupansi event MICE."
  ogImage="/img/partisi-ruang-rapat-hotel_poco.webp"
  schemaExtra={[schemaService, schemaBreadcrumb]}
>
  <div class="py-6 bg-[#0a1428] border-b border-white/10 text-xs font-mono">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-400">
      <a href="/" class="hover:text-white flex items-center gap-1">
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Beranda</span>
      </a>
      <span>/</span>
      <span class="text-[#00e5ff]">Meeting Room Hotel</span>
    </div>
  </div>

  <section class="py-12 lg:py-20 bg-blueprint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00e5ff]/10 text-[#00e5ff] text-xs font-mono">
            <Hotel class="w-3.5 h-3.5" />
            <span>HOSPITALITY & MICE INDUSTRY</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Partisi Meeting Room Hotel & Ballroom Multifungsi
          </h1>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Bisnis hospitality menuntut fleksibilitas ruang rapat (MICE) yang tinggi. Hotel dapat menyewakan satu ruangan ballroom besar secara utuh untuk acara pernikahan, atau membaginya menjadi 3 ruang rapat seminar independen pada hari kerja secara bersamaan tanpa saling mengganggu.
          </p>

          <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-4">
            <h2 class="text-lg font-bold text-white">
              Mengapa Hotel Memilih Sistem Rel Gantung Pireki?
            </h2>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong>Karpet Mewah Bebas Rusak:</strong> Tanpa rel tanam di lantai, karpet ballroom tetap mulus dan bebas resiko tamu tersandung gaun atau sepatu hak tinggi.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong>Kemudahan Operasional Banquet:</strong> Staf hotel dapat membuka dan menutup partisi hanya dalam hitungan menit dengan rel gantung bearing Jepang yang sangat halus.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong>Penyimpanan Rapi (Stacking Pocket):</strong> Saat dibuka, daun partisi terparkir rapi di balik lemari penyimpanan tersembunyi (pocket doors).</span>
              </li>
            </ul>
          </div>

        </div>

        <div class="lg:col-span-4 space-y-6">
          <!-- Foto Visual Fasilitas Hotel 4:3 -->
          <div class="glass-panel rounded-2xl overflow-hidden border border-white/15 shadow-2xl group">
            <div class="aspect-[4/3] w-full overflow-hidden bg-black/40 relative">
              <img
                src="/img/partisi-ruang-rapat-hotel_poco.webp"
                alt="Penerapan Partisi Ruang Rapat Ballroom Hotel Pireki"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width="800"
                height="600"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#070e1e]/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs">
                <span class="font-mono text-emerald-300 font-semibold bg-[#070e1e]/90 px-2.5 py-1 rounded border border-emerald-500/30">
                  Meeting Room & Ballroom Hotel
                </span>
                <span class="font-mono text-slate-300 text-[11px] bg-black/60 px-2 py-1 rounded">
                  Pireki
                </span>
              </div>
            </div>
          </div>

          <div class="glass-panel rounded-2xl p-6 border border-[#00e5ff]/30 shadow-xl">
            <h3 class="text-lg font-bold text-white mb-2">
              Proyek Hotel Terpasang
            </h3>
            <p class="text-xs text-slate-300 mb-4">
              Hotel Ayola Signature Ocarina Batam, Furaya Hotel Pekanbaru, Front One Jayapura, dan berbagai hotel bintang di Indonesia.
            </p>
            <a
              href="https://wa.me/6282376737701?text=Halo%20Pireki%2C%20kami%20ingin%20konsultasi%20partisi%20meeting%20room%20hotel"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-[#00e5ff] hover:bg-white text-[#070e1e] font-bold text-xs uppercase tracking-wider transition-all"
            >
              <Phone class="w-4 h-4" />
              <span>Konsultasi Proyek Hotel (WA)</span>
            </a>
          </div>
        </div>

      </div>

      <!-- KONTEN MENDALAM E-E-A-T PENERAPAN HOTEL -->
      <div class="mt-16 pt-12 border-t border-white/10 space-y-12">

        <!-- Optimalisasi Pendapatan MICE -->
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Meningkatkan Pendapatan Sewa Ruangan MICE Melalui Zonasi Modular
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Dalam industri perhotelan, okupansi ballroom merupakan salah satu kontributor pendapatan terbesar di luar sewa kamar. Kendala umum yang sering dihadapi manajemen hotel adalah ballroom besar yang sering kosong di hari kerja karena jarang ada acara pernikahan atau konser berskala raksasa di hari kerja biasa.
          </p>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Dengan memasang sistem movable wall Sorepa Pro dari CV Pireki Asia, satu grand ballroom dapat disekat menjadi tiga ruang seminar independen. Manajemen hotel dapat menjual tiga paket meeting korporat atau instansi kedinasan secara bersamaan di hari kerja, lalu membuka kembali seluruh sekat menjadi satu aula megah saat akhir pekan tiba.
          </p>
        </div>

        <!-- Mencegah Kebocoran Suara Antar Event Simultan -->
        <div class="space-y-6">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Isolasi Akustik 60 dB Mencegah Benturan Suara Antara Dua Acara Berbeda
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Risiko terburuk dalam penyewaan ruangan paralel adalah komplain dari penyewa ruang rapat akibat dentuman suara musik atau sound system dari ruangan sebelah. Sistem partisi Sorepa Pro Pireki dirancang dengan peredam Rockwool padat densitas 80 kg/m³ dan rubber seal mekanik yang memutus kebocoran frekuensi audio bass maupun vokal:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="glass-panel p-5 rounded-xl border border-white/10 space-y-2">
              <span class="text-[#00e5ff] font-mono text-xs uppercase tracking-wider block">Seminar vs Resepsi</span>
              <h3 class="text-lg font-bold text-white">Bebas Gangguan Audio</h3>
              <p class="text-slate-400 text-xs leading-relaxed">
                Rapat evaluasi korporat yang membutuhkan keheningan dapat berlangsung tepat di sebelah ruangan pesta perayaan tanpa terdistraksi dentuman musik.
              </p>
            </div>

            <div class="glass-panel p-5 rounded-xl border border-white/10 space-y-2">
              <span class="text-[#00e5ff] font-mono text-xs uppercase tracking-wider block">Kenyamanan Tamu</span>
              <h3 class="text-lg font-bold text-white">Karpet Bebas Cacat Rel</h3>
              <p class="text-slate-400 text-xs leading-relaxed">
                Rel gantung murni di langit-langit tanpa jalur lantai memastikan karpet tenun wool ballroom tetap utuh, mulus, dan bebas bahaya tersandung bagi gaun pengantin.
              </p>
            </div>

            <div class="glass-panel p-5 rounded-xl border border-white/10 space-y-2">
              <span class="text-[#00e5ff] font-mono text-xs uppercase tracking-wider block">Kecepatan Staf</span>
              <h3 class="text-lg font-bold text-white">Banquet Turnaround Cepat</h3>
              <p class="text-slate-400 text-xs leading-relaxed">
                Roda bearing Jepang membuat pergeseran panel setinggi 6 meter tetap ringan digerakkan oleh staf banquet dalam persiapan pergantian susunan ruangan.
              </p>
            </div>
          </div>
        </div>

        <!-- Rekam Jejak Portofolio di Hotel Terkemuka -->
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Portofolio Terpasang di Jaringan Perhotelan Nasional
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            CV Pireki Asia telah menyelesaikan instalasi partisi ballroom di berbagai kota strategis dan kawasan pariwisata di Indonesia:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
            <div class="p-4 rounded-xl bg-black/30 border border-white/10 space-y-2">
              <strong class="text-[#00e5ff] block font-mono text-sm">Hotel Ayola Signature Ocarina di Batam</strong>
              <p class="text-slate-300 leading-relaxed">
                Pemasangan partisi ballroom bergerak tipe Sorepa kedap suara untuk mendukung fasilitas pertemuan bisnis internasional dan pariwisata MICE kawasan Batam Kepulauan Riau.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-black/30 border border-white/10 space-y-2">
              <strong class="text-[#00e5ff] block font-mono text-sm">Furaya Hotel di Pekanbaru</strong>
              <p class="text-slate-300 leading-relaxed">
                Penyekat ruangan serbaguna function room hotel bintang untuk mengakomodasi kegiatan pameran, akad nikah, dan seminar kedinasan secara bergantian.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ProyekTerkait
    aplikasi="hotel"
    title="Dokumentasi Proyek Partisi Hotel & Ballroom"
    eyebrow="PORTOFOLIO HOSPITALITY & MICE"
    description="Implementasi movable wall peredam suara CV Pireki Asia di ballroom hotel dan meeting room serbaguna."
  />

  <CtaSection />
</Layout>
