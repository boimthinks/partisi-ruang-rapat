---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProdukGrid from '../components/ProdukGrid.astro';
import SektorSection from '../components/SektorSection.astro';
import KalkulatorEstimasi from '../components/KalkulatorEstimasi.astro';
import ProyekShowcase from '../components/ProyekShowcase.astro';
import LokasiSection from '../components/LokasiSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { VolumeX, Shield, Award, Sparkles, Check, ArrowRight } from '@lucide/astro';
---

<Layout
  title="Partisi Ruang Rapat Kedap Suara | Produsen Movable Wall Pireki"
  description="Produsen partisi ruang rapat kedap suara hingga 60 dB. Spesialis sekat geser movable wall & folding door kantor, hotel, dan ballroom resmi CV Pireki Asia."
>
  <Hero />

  <!-- Mengapa Privasi Akustik Sangat Penting di Ruang Rapat -->
  <section class="py-16 lg:py-24 relative reveal-on-scroll">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00e5ff]/10 text-[#00e5ff] text-xs font-mono">
            <VolumeX class="w-3.5 h-3.5" />
            <span>STANDAR PRIVASI KORPORASI</span>
          </div>
          
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight">
            Cegah Kebocoran Informasi Strategis & Gangguan Audio
          </h2>

          <p class="text-slate-300 text-sm leading-relaxed">
            Rapat dewan direksi, tender rahasia, audit keuangan, dan konferensi video memerlukan isolasi suara berstandar tinggi. Partisi konvensional seringkali bocor melalui celah lantai dan rongga plafon.
          </p>

          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
            CV Pireki Asia merancang sistem <strong class="text-white">Sorepa Pro</strong> dengan karet seal bertekanan mekanik (jack device) dan peredam Rockwool berdensitas 80 kg/m³ yang mampu memblokir kebisingan hingga 60 dB.
          </p>

          <div class="pt-2">
            <a
              href="/teknis/material-akustik-60db/"
              class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[#00e5ff] hover:text-white transition-colors"
            >
              <span>Pelajari Standar Akustik 60 dB</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div class="glass-panel p-6 rounded-xl border border-white/10 hover:border-[#00e5ff]/30 transition-all">
            <div class="w-10 h-10 rounded-lg bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center mb-4">
              <Shield class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-2">Pabrikasi Sendiri Sejak 2011</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Bukan perantara atau agen. Seluruh komponen rel aluminium, hollow, dan panel dirakit di workshop kami di Surabaya dan Gresik.
            </p>
          </div>

          <div class="glass-panel p-6 rounded-xl border border-white/10 hover:border-[#00e5ff]/30 transition-all">
            <div class="w-10 h-10 rounded-lg bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center mb-4">
              <Award class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-2">Legalitas & TKDN Lengkap</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Memenuhi kualifikasi pengadaan BUMN dan instansi pemerintah dengan NIB resmi, Merek IDM000746833, dan sertifikasi TKDN.
            </p>
          </div>

          <div class="glass-panel p-6 rounded-xl border border-white/10 hover:border-[#00e5ff]/30 transition-all">
            <div class="w-10 h-10 rounded-lg bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center mb-4">
              <Sparkles class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-2">Desain Finishing Fleksibel</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Dapat diselaraskan dengan interior ruang rapat: Finishing HPL motif kayu mewah, kain fabric akustik Ateja, atau wallpaper modern.
            </p>
          </div>

          <div class="glass-panel p-6 rounded-xl border border-white/10 hover:border-[#00e5ff]/30 transition-all">
            <div class="w-10 h-10 rounded-lg bg-[#00e5ff]/10 text-[#00e5ff] flex items-center justify-center mb-4">
              <Check class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-white mb-2">Layanan Garansi 2 Tahun</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Didukung teknisi berpengalaman untuk instalasi presisi, penyetelan kelancaran roda rel, dan layanan purna jual berkala.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Katalog Produk Ruang Rapat -->
  <ProdukGrid columns={2} />

  <!-- Sektor Ruang Rapat -->
  <SektorSection />

  <!-- Kalkulator Estimasi Kebutuhan & Biaya -->
  <KalkulatorEstimasi />

  <!-- Portofolio Proyek Terpasang -->
  <ProyekShowcase />

  <!-- Wilayah Layanan Pemasangan di Kota-Kota Besar -->
  <LokasiSection />

  <!-- Call To Action -->
  <CtaSection />
</Layout>
