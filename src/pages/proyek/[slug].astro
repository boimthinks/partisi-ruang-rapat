---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSection.astro';
import ProyekTerkait from '../../components/ProyekTerkait.astro';
import GoogleSourcePreferences from '../../components/GoogleSourcePreferences.astro';
import { ArrowLeft, MapPin, CheckCircle2, Phone, Calculator, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const proyekEntries = await getCollection('artikel', ({ data }) => data.label === 'proyek');
  return proyekEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const schemaBreadcrumb = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://partisiruangrapat.web.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Daftar Proyek Terpasang",
      "item": "https://partisiruangrapat.web.id/proyek/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": entry.data.title,
      "item": `https://partisiruangrapat.web.id/proyek/${entry.id}/`
    }
  ]
};

const datePublishedISO = entry.data.date ? new Date(entry.data.date).toISOString() : new Date().toISOString();

const schemaArticle = {
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image ? `https://partisiruangrapat.web.id${entry.data.image}` : undefined,
  "datePublished": datePublishedISO,
  "author": {
    "@type": "Organization",
    "name": entry.data.author || "Tim Supervisi Proyek Pireki",
    "url": "https://partisiruangrapat.web.id/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CV Pireki Asia",
    "url": "https://partisiruangrapat.web.id/"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://partisiruangrapat.web.id/proyek/${entry.id}/`
  }
};
---

<Layout
  title={`${entry.data.title} | Proyek Pireki`}
  description={entry.data.description}
  ogImage={entry.data.image}
  schemaExtra={[schemaBreadcrumb, schemaArticle]}
>
  <div class="py-6 bg-[#0a1428] border-b border-white/10 text-xs font-mono">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-400">
      <a href="/proyek/" class="hover:text-white flex items-center gap-1">
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Daftar Proyek Terpasang</span>
      </a>
      <span>/</span>
      <span class="text-[#00e5ff] truncate max-w-xs">{entry.data.title}</span>
    </div>
  </div>

  <article class="py-12 lg:py-20 relative bg-blueprint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Main Column (8 Cols) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Metadata Header -->
          <div class="space-y-4 pb-6 border-b border-white/10">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider text-[#00e5ff] bg-[#00e5ff]/10 px-2.5 py-1 rounded">
                Proyek
              </span>
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded">
                {entry.data.aplikasi}
              </span>
              {entry.data.lokasi && (
                <span class="text-xs font-mono text-cyan-300 bg-white/5 px-2.5 py-1 rounded border border-white/10 flex items-center gap-1">
                  <MapPin class="w-3 h-3 text-[#00e5ff]" />
                  <span>{entry.data.lokasi}</span>
                </span>
              )}
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              {entry.data.title}
            </h1>

            {entry.data.tipe && (
              <div class="flex items-center gap-2 text-xs font-mono text-slate-300">
                <CheckCircle2 class="w-4 h-4 text-emerald-400" />
                <span>Tipe Partisi: <strong class="text-white">{entry.data.tipe}</strong></span>
              </div>
            )}
          </div>

          <!-- Foto Showcase Proyek 4:3 -->
          {entry.data.image && (
            <div class="glass-panel rounded-2xl overflow-hidden border border-white/15 shadow-2xl group">
              <div class="aspect-[4/3] w-full overflow-hidden bg-black/40 relative">
                <img
                  src={entry.data.image}
                  alt={entry.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800"
                  height="600"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#070e1e]/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs">
                  <span class="font-mono text-[#00e5ff] font-semibold bg-[#070e1e]/90 px-2.5 py-1 rounded border border-[#00e5ff]/30">
                    {entry.data.tipe}
                  </span>
                  {entry.data.lokasi && (
                    <span class="font-mono text-slate-300 text-[11px] bg-black/60 px-2 py-1 rounded flex items-center gap-1">
                      <MapPin class="w-3 h-3 text-[#00e5ff]" />
                      <span>{entry.data.lokasi}</span>
                    </span>
                  )}
                </div>
              </div>
            </div>
          )}

          <!-- Article Body Container -->
          <div class="article-content glass-panel p-6 sm:p-10 rounded-2xl border border-white/10 shadow-2xl">
            <Content />
          </div>

          <!-- Google Source Preferences Widget -->
          <GoogleSourcePreferences variant="article" />

        </div>

        <!-- Right: Sticky CTA Sidebar (4 Cols) -->
        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
          <div class="glass-panel rounded-2xl p-6 sm:p-7 border border-[#00e5ff]/30 shadow-2xl relative">
            <div class="text-[11px] font-mono text-[#00e5ff] uppercase tracking-wider font-semibold mb-2">
              Konsultasi Proyek & RAB
            </div>
            <h3 class="text-xl font-bold text-white mb-3">
              Pasang Partisi Seperti Proyek Ini?
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-6">
              Konsultasikan kebutuhan partisi ruangan Anda langsung ke pabrik CV Pireki Asia. Kami menyediakan asistensi gambar kerja, perhitungan beban balok gantung, dan survei lokasi.
            </p>

            <!-- Ringkasan Info Proyek -->
            <div class="space-y-2.5 p-4 rounded-xl bg-black/40 border border-white/5 text-xs mb-6">
              {entry.data.tipe && (
                <div class="flex items-center justify-between">
                  <span class="text-slate-400">Tipe Partisi:</span>
                  <strong class="text-[#00e5ff] font-mono">{entry.data.tipe}</strong>
                </div>
              )}
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Penerapan:</span>
                <span class="text-white capitalize">{entry.data.aplikasi}</span>
              </div>
              {entry.data.lokasi && (
                <div class="flex items-center justify-between">
                  <span class="text-slate-400">Lokasi:</span>
                  <span class="text-slate-200">{entry.data.lokasi}</span>
                </div>
              )}
              <div class="flex items-center justify-between pt-2 border-t border-white/10">
                <span class="text-slate-400">Jaminan Mutu:</span>
                <span class="text-emerald-400 font-medium">Garansi 2 Tahun</span>
              </div>
            </div>

            <!-- Tombol WhatsApp CTA -->
            <a
              href={`https://wa.me/6282376737701?text=${encodeURIComponent(`Halo CV Pireki Asia, saya tertarik dengan proyek "${entry.data.title}" dan ingin konsultasi untuk ruangan saya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-lg bg-[#00e5ff] hover:bg-white text-[#070e1e] font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-[#00e5ff]/20"
            >
              <Phone class="w-4 h-4" />
              <span>Konsultasi Proyek (WA)</span>
            </a>

            <!-- Link Bantuan -->
            <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
              <a href="/harga/" class="text-[#00e5ff] hover:underline flex items-center gap-1.5">
                <Calculator class="w-3.5 h-3.5" />
                <span>Simulasi Biaya</span>
              </a>
              <a href="/proyek/" class="text-slate-400 hover:text-white flex items-center gap-1">
                <span>Semua Proyek</span>
                <ArrowRight class="w-3 h-3" />
              </a>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </article>

  <ProyekTerkait
    aplikasi={entry.data.aplikasi}
    title="Dokumentasi Proyek Lainnya"
    eyebrow="PORTOFOLIO TERKAIT"
    description="Eksplorasi instalasi partisi terpasang lainnya pada sektor serupa di berbagai wilayah Indonesia."
  />

  <CtaSection />
</Layout>
