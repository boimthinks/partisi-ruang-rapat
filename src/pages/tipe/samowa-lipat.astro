const schemaBreadcrumb = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://partisiruangrapat.web.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tipe Partisi",
      "item": "https://partisiruangrapat.web.id/tipe/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Samowa Lipat",
      "item": "https://partisiruangrapat.web.id/tipe/samowa-lipat/"
    }
  ]
