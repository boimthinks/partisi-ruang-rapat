  },
  "category": "Building Materials > Doors > Folding Doors & Movable Walls",
  "offers": {
    "@type": "AggregateOffer",
    "url": "https://partisiruangrapat.web.id/tipe/samowa-lipat/",
    "priceCurrency": "IDR",
    "lowPrice": 1758000,
    "highPrice": 2100000,
    "offerCount": 4,
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@id": "https://partisiruangrapat.web.id/#organization"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": 4.7,
    "reviewCount": 88,
    "ratingCount": 88,
    "bestRating": 5,
    "worstRating": 1
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": 5,
        "bestRating": 5,
        "worstRating": 1
      },
      "author": {
        "@type": "Person",
        "name": "Agus Wicaksono",
        "worksFor": {
          "@type": "Organization",
          "name": "Pertamina Hulu Rokan Hilir"
        }
      },
      "datePublished": "2026-04-05",
      "reviewBody": "Pintu lipat Samowa sangat praktis untuk ruang rapat lapangan dan aula serbaguna. Konstruksi rangka kokoh dan buka tutup cepat."
    },
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": 5,
        "bestRating": 5,
        "worstRating": 1
      },
      "author": {
        "@type": "Person",
        "name": "Tri Wahyudi",
        "worksFor": {
          "@type": "Organization",
          "name": "Balai Pelatihan Teknis Surabaya"
        }
      },
      "datePublished": "2026-04-12",
      "reviewBody": "Sistem lipatnya ringan ditarik dan dirapikan ke sisi dinding. Sangat efektif untuk membagi ruang kelas pelatihan kami."
    }
  ],
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "Acoustic Rating",
      "value": "Semi Kedap Suara"
    },
    {
      "@type": "PropertyValue",
      "name": "Insulasi Inti",
      "value": "Glasswool 30 kg/m³"
    },
    {
      "@type": "PropertyValue",
      "name": "Mekanisme Pengunci",
      "value": "Grendel Tanam Manual & Engsel Kupu-kupu"
    },
