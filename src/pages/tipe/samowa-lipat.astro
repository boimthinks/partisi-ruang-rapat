---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSection.astro';
import ProyekTerkait from '../../components/ProyekTerkait.astro';
import { Layers, CheckCircle2, Phone, ArrowLeft, Ruler } from '@lucide/astro';

const schemaProduct = {
  "@type": "Product",
  "@id": "https://partisiruangrapat.web.id/tipe/samowa-lipat/#product",
  "name": "Partisi Lipat Ruang Rapat Samowa Semi-Redam",
  "image": "https://partisiruangrapat.web.id/img/tipe-samowa-lipat_poco.webp",
  "description": "Pintu partisi lipat ruang rapat Samowa semi-redam suara. Praktis dan ekonomis mulai Rp 1.758.000/m², cocok untuk kantor dan ruang pelatihan serbaguna.",
  "sku": "PIREKI-SAMOWA-LIPAT",
  "mpn": "SAMOWA-LIPAT-FOLDING",
  "brand": {
    "@type": "Brand",
    "name": "Pireki"
  },
  "manufacturer": {
